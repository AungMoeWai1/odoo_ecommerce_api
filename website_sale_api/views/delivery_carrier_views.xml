<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_delivery_carrier_form_township" model="ir.ui.view">
        <field name="name">delivery.carrier.form.township</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state_ids']" position='after'>
                <field name="township_ids"
                       widget="many2many_tags"
                       domain="[('state_id', 'in', state_ids)]"
                       readonly="not state_ids"
                       force_save="1"
                       options="{'no_create': True}"/>
            </xpath>
            <xpath expr="/form//field[@name='tracking_url']" position="after">
                <field name="free_township_amount"
                       help="The township amount will not added in the delivery method cost."/>
            </xpath>
        </field>
    </record>
</odoo>
