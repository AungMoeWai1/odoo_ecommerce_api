<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_sale_website_form" model="ir.ui.view">
        <field name="name">website_sale.website.form</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form//page[@name='page_product_page_extra_fields']" position="after">
                <page string="Term and Conditions">

                    <field name="term_and_condition" type="html" class="oe_description" default_focus="1"
                           options="{'resizable': false, 'collaborative': true}" placeholder="Terms and Conditions"/>

                </page>
            </xpath>
        </field>
    </record>
</odoo>