<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_website_promotion_popup_list" model="ir.ui.view">
        <field name="name">website.promotion.popup.list</field>
        <field name="model">website.promotion.popup</field>
        <field name="arch" type="xml">
            <list string="Promotion Popup">
                <field name="product_id"/>
                <field name="description"/>
                <field name="is_published"/>
            </list>
        </field>
    </record>

    <record id="view_website_promotion_popup_form" model="ir.ui.view">
        <field name="name">website.promotion.popup.form</field>
        <field name="model">website.promotion.popup</field>
        <field name="arch" type="xml">
            <form string="Promotion Popup">
                <field name="is_published" invisible="1"/>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_toggle_is_published"
                                invisible="not is_published"
                                class="oe_stat_button"
                                type="object"
                                icon="fa-globe">
                            <div class="o_stat_info o_field_widget">
                                <span class="o_stat_text text-success">Published</span>
                            </div>
                        </button>
                        <button name="action_toggle_is_published"
                                invisible="is_published"
                                class="oe_stat_button"
                                type="object"
                                icon="fa-eye-slash">
                            <div class="o_stat_info o_field_widget">
                                <span class="o_stat_text text-danger">Unpublished</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field
                                    name="image_1920"
                                    widget="image" options="{'size': [256, 256]}"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_view_promotion_popup" model="ir.actions.act_window">
        <field name="name">Promotion Popup</field>
        <field name="res_model">website.promotion.popup</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first promotion popup
            </p>
            <p>
                Promotion popup can be used to display promotional images and descriptions.
            </p>
        </field>
    </record>


    <menuitem
            action="action_view_promotion_popup"
            id="promotion_popup"
            parent="firebase_sync_log.menu_notifiaction_log"
            sequence="2"/>
</odoo>