<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_res_township_list" model="ir.ui.view">
        <field name="name">res.township.list</field>
        <field name="model">res.township</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="price"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_res_township_form" model="ir.ui.view">
        <field name="name">res.township.form</field>
        <field name="model">res.township</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Township Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="price"/>
                        </group>
                        <group>
                            <field name="state_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_res_township" model="ir.actions.act_window">
        <field name="name">Townships</field>
        <field name="res_model">res.township</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Township
            </p>
            <p>
                Manage townships and their pricing information.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_res_township_main"
              name="Townships"
              parent="contacts.menu_localisation"
              action="action_res_township"
              sequence="4"/>

</odoo>