<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="notification_message_wizard_view_form" model="ir.ui.view">
        <field name="name">notification.message.wizard.view.form</field>
        <field name="model">notification.message.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>

                        <group>
                            <field name="send_by"/>
                            <field name="send_to" widget="many2many_tags" invisible="send_by=='all'"/>
                        </group>
                        <group>

                        </group>
                        <field name="title" placeholder="Title"/>
                        <field name="message" placeholder="Message Body" widget="text"/>
                    </group>
                </sheet>
                <footer>
                    <button type="object" name="action_send" string="send" class="btn btn-primary"
                            data-hotkey="q"/>
                    <button special="cancel" string="Discard" class="btn btn-secondary"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="noti_message_wizard_action" model="ir.actions.act_window">
        <field name="name">Notification Message</field>
        <field name="res_model">notification.message.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
