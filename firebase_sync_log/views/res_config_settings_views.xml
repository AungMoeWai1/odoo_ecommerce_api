<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adding fields in res.config.settings -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.notification.message</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//app[@name='website']" position="inside">
                <block title="Mobile Notification">
                    <setting id="mobile_notification" company_dependent="1"
                             help="Enable mobile notification to send message">
                        <field name="enable_notification"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
